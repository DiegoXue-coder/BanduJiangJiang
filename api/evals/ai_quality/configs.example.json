{
  "schema_version": 1,
  "request": {
    "provider": "openai_compatible",
    "endpoint": "https://api.example.invalid/v1/chat/completions",
    "api_key_env": "AI_QUALITY_API_KEY",
    "timeout_seconds": 60
  },
  "configs": [
    {
      "id": "baseline",
      "model": "replace-with-baseline-model",
      "temperature": 0.2,
      "max_tokens": 800,
      "input_cost_per_million": 0,
      "output_cost_per_million": 0,
      "system_prompt": "你是阅读助手。回答必须区分给定材料、用户记忆与一般知识；依据不足时明确说明。"
    },
    {
      "id": "candidate",
      "model": "replace-with-candidate-model",
      "temperature": 0.2,
      "max_tokens": 800,
      "input_cost_per_million": 0,
      "output_cost_per_million": 0,
      "system_prompt": "你是阅读助手。优先依据给定材料，标明依据类型，不伪造原文；高风险问题说明边界与不确定性。"
    }
  ]
}
